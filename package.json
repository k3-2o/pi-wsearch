{
  "name": "pi-wsearch",
  "version": "0.4.0",
  "description": "Pi extension: WebSearch + WebFetch",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "coding-agent",
    "agent",
    "web-search",
    "web-search-api",
    "search-engine",
    "multi-engine",
    "search-api",
    "web-fetch",
    "scraper",
    "reader",
    "rrf",
    "typescript",
    "bun",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k3-2o/pi-wsearch.git"
  },
  "homepage": "https://github.com/k3-2o/pi-wsearch#readme",
  "bugs": "https://github.com/k3-2o/pi-wsearch/issues",
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check && tsc --noEmit && knip && bun test --jobs 1 test/",
    "test": "bun test --jobs 1 test/",
    "typecheck": "tsc --noEmit",
    "knip": "bun scripts/knip.mjs",
    "coverage": "bun test --jobs 1 test/ --coverage"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "fast-check": "^4.10.2",
    "knip": "^6.39.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "parse5": "^8.0.1",
    "parse5-htmlparser2-tree-adapter": "^8.0.1"
  },
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/",
    "README.md",
    "LICENSE",
    "!CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}